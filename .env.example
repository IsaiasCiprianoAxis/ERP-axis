# Copie para .env.local e preencha. NUNCA commite o .env.local.
# Usado por scripts da raiz (migrations, criação do admin, testes de RLS).

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chave com acesso total, que ignora o RLS. Use só em scripts locais e
# testes. Nunca a coloque no web/ ou no mobile/.
SUPABASE_SERVICE_ROLE_KEY=
