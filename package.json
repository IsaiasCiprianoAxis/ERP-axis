{
  "name": "home-care-os",
  "private": true,
  "type": "module",
  "description": "Home Care OS: ERP para gestão de home care (web, mobile e Supabase)",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > supabase/database.types.ts",
    "admin:criar": "node --env-file=.env.local scripts/criar-admin.ts",
    "usuario:criar": "node --env-file=.env.local scripts/criar-usuario.ts",
    "lint": "eslint .",
    "test:rls": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:rls"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
